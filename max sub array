;
; Complete the 'maximumSum' function below.
;
; The function is expected to return a LONG_INTEGER.
; The function accepts following parameters:
;  1. LONG_INTEGER_ARRAY a
;  2. LONG_INTEGER m
;

(defn maximumSum [a m]
  (loop [xs (seq a)
         prefix 0
         best 0
         seen (sorted-set 0)]
    (if (empty? xs)
      best
      (let [x (first xs)
            new-prefix (mod (+ prefix x) m)
            larger (first (subseq seen > new-prefix))
            candidate (if larger
                        (mod (+ (- new-prefix larger) m) m)
                        new-prefix)]
        (recur (rest xs)
               new-prefix
               (max best candidate)
               (conj seen new-prefix))))))

